# Copy to .env and adjust if needed. The values below match docker-compose.yml (local sandbox only).

# Dev database used by db:migrate and db:seed.
DATABASE_URL=postgres://veripura:veripura_local_only@localhost:5433/veripura

# Test database used by the Vitest suite. It is created automatically on first run and
# truncated between tests, so it must NEVER point at a database holding data you care about.
TEST_DATABASE_URL=postgres://veripura:veripura_local_only@localhost:5433/veripura_test

# --- VeriPura core integration -------------------------------------------------------------
# stub: no network, returns a hardcoded checklist after a short delay. live: real HTTP to core.
VERIPURA_CORE_MODE=stub
VERIPURA_CORE_STUB_DELAY_MS=250
# Required only when VERIPURA_CORE_MODE=live.
VERIPURA_CORE_WEBHOOK_URL=
# Shared secret for HMAC-SHA256 signing of webhook bodies, both directions. The value below is a
# placeholder for the local sandbox only. Use a real random secret anywhere else.
VERIPURA_CORE_WEBHOOK_SECRET=local-sandbox-secret-not-for-production

# --- HTTP layer ----------------------------------------------------------------------------
# Not 3000: Next.js dev servers (such as the tower demo) use that on this machine.
PORT=3100
# Sandbox stand-in for real sign-in: trust an X-Acting-User-Id header on POST /purchase-orders.
# Leave false anywhere but local manual testing. Real authentication is a separate prompt.
ALLOW_DEV_ACTOR_HEADER=false
# Where the local file storage writes uploaded purchase orders.
STORAGE_DIR=.storage

# --- Dev-only acting user (for local UI development) ---------------------------------------
# AUTH_MODE=dev lets a client act as any user by sending an X-Dev-User header (a user id), and
# enables GET /dev/users for the dev user switcher. The server REFUSES TO START if this is on
# with NODE_ENV=production. Real sign-in is a separate prompt. Leave empty to disable.
# (ALLOW_DEV_ACTOR_HEADER=true is a deprecated alias for the same thing.)
AUTH_MODE=dev
