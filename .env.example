# Copy to .env and adjust if needed. The values below match docker-compose.yml (local sandbox only).

# Dev database used by db:migrate and db:seed.
DATABASE_URL=postgres://veripura:veripura_local_only@localhost:5433/veripura

# Test database used by the Vitest suite. It is created automatically on first run and
# truncated between tests, so it must NEVER point at a database holding data you care about.
TEST_DATABASE_URL=postgres://veripura:veripura_local_only@localhost:5433/veripura_test
